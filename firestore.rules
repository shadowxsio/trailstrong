rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// Règles Firestore du projet trailstrong-646d0, PARTAGÉ par deux apps :
//   - TrailStrong  (users/…)    : chaque compte ne voit que ses données ;
//   - TrailJourney (sessions/…) : suivi en direct par lien secret.
// Firebase n'a qu'UN fichier de règles par base : publier les règles d'une seule
// app efface celles de l'autre. Ce fichier est identique dans les deux dépôts
// (shadowxsio/trailstrong et shadowxsio/trailjourney) ; le publier depuis l'un
// ou l'autre revient au même. Tests : npm run test:rules (dépôt trailjourney).
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ TrailStrong ═══
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function optString(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    // users/{uid} : profil, réglages, programme
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'profile', 'settings', 'program', 'onboarded', 'createdAt', 'updatedAt'])
        && optString(request.resource.data, 'email', 200)
        && optString(request.resource.data, 'name', 100)
        && optString(request.resource.data, 'photo', 1000)
        && (!('profile' in request.resource.data) || request.resource.data.profile is map)
        && (!('settings' in request.resource.data) || request.resource.data.settings is map)
        && (!('program' in request.resource.data) || request.resource.data.program == null || request.resource.data.program is map)
        && (!('onboarded' in request.resource.data) || request.resource.data.onboarded is bool);

      // days/{AAAA-MM-JJ} : séries, douleurs, tests, bilans du jour
      match /days/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['logs', 'checkin', 'tests', 'sessions', 'updatedAt'])
          && request.resource.data.updatedAt is number
          && (!('logs' in request.resource.data) || (request.resource.data.logs is map && request.resource.data.logs.size() <= 150))
          && (!('tests' in request.resource.data) || (request.resource.data.tests is map && request.resource.data.tests.size() <= 30))
          && (!('sessions' in request.resource.data) || (request.resource.data.sessions is map && request.resource.data.sessions.size() <= 10));
      }

      // custom/{custom-<horodatage>} : exercices ajoutés (photos comprises)
      match /custom/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && id.matches('^custom-[0-9]{10,16}$')
          && request.resource.data.keys().hasOnly([
            'id', 'name', 'target', 'protocol', 'rest', 'startWeight', 'tip', 'createdAt', 'source', 'catalogId',
            'tags', 'equipment', 'sets', 'reps', 'defaultReps', 'perSide', 'restS', 'mode', 'cadence', 'steps',
            'stepsLang', 'points', 'kneeAnkle', 'diagram', 'photos', 'video', 'sessionId'
          ])
          && request.resource.data.id == id
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.sessionId in ['activation', 'seanceA', 'seanceB', 'tapis']
          && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 2))
          && (!('steps' in request.resource.data) || (request.resource.data.steps is list && request.resource.data.steps.size() <= 12));
      }
    }

    // ═══ TrailJourney ═══
    // sessions/{id} : un live. Lecture UNIQUEMENT avec l'identifiant exact
    // (24 caractères aléatoires) tant que le live est ouvert ; aucune liste.
    // sessions/{id}/private/secrets : empreinte SHA-256 du jeton OwnTracks,
    // jamais lisible (la Cloud Function owntracksPing la lit en admin).

    // Coureur : compte Google vérifié qui a aussi un compte TrailStrong.
    function isRunner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isNum(d, k) {
      return !(k in d) || d[k] is number;
    }

    function validPosition(p) {
      return p is map
        && p.keys().hasOnly(['lat', 'lon', 'alt', 'batt', 'vel', 'timestamp'])
        && p.lat is number && p.lat >= -90 && p.lat <= 90
        && p.lon is number && p.lon >= -180 && p.lon <= 180
        && p.alt is number && p.batt is number && p.vel is number && p.timestamp is number;
    }

    // Forme d'une session (mêmes champs que la première version : compatibles
    // avec la Cloud Function et les sessions déjà créées).
    function validSession(d) {
      return d.keys().hasOnly([
          'id', 'ownerUid', 'runnerName', 'runnerLevel', 'trackTitle', 'trackPoints', 'waypoints',
          'totalDistanceKm', 'totalElevationGain', 'totalElevationLoss', 'powerMode', 'isActive',
          'createdAt', 'startedAt', 'expiresAt', 'lastPosition', 'distanceOnTrackKm', 'nextWaypointIndex',
          'averagePaceMinKm', 'etaNextTimestamp', 'etaFinishTimestamp'
        ])
        && d.runnerName is string && d.runnerName.size() > 0 && d.runnerName.size() <= 40
        && d.trackTitle is string && d.trackTitle.size() <= 80
        && d.trackPoints is list && d.trackPoints.size() >= 2 && d.trackPoints.size() <= 1200
        && d.waypoints is list && d.waypoints.size() <= 60
        && d.powerMode in ['high', 'normal', 'eco', 'ultra_eco']
        && d.isActive is bool
        && d.createdAt is number && d.startedAt is number && d.expiresAt is number
        && d.totalDistanceKm is number
        && (!('lastPosition' in d) || validPosition(d.lastPosition))
        && isNum(d, 'distanceOnTrackKm') && isNum(d, 'nextWaypointIndex') && isNum(d, 'averagePaceMinKm')
        && isNum(d, 'etaNextTimestamp') && isNum(d, 'etaFinishTimestamp');
    }

    match /sessions/{sessionId} {
      // Spectateurs : le live doit être ouvert (horloge du serveur). Le coureur relit toujours le sien.
      allow get: if (resource.data.isActive == true && request.time.toMillis() < resource.data.expiresAt)
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);

      // Anti-énumération : aucune requête de liste, pour personne.
      allow list: if false;

      allow create: if isRunner()
        && sessionId.matches('^[0-9A-Za-z]{24}$')
        && request.resource.data.id == sessionId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isActive == true
        && validSession(request.resource.data)
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 48 * 3600 * 1000;

      // Le coureur ne touche qu'aux champs « en direct » (tracé, nom, propriétaire figés).
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastPosition', 'distanceOnTrackKm', 'nextWaypointIndex', 'averagePaceMinKm',
          'etaNextTimestamp', 'etaFinishTimestamp', 'isActive', 'expiresAt', 'startedAt', 'powerMode'
        ])
        && validSession(request.resource.data)
        && request.resource.data.expiresAt <= resource.data.createdAt + 48 * 3600 * 1000;

      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /private/{docId} {
        allow read: if false;
        allow create, update: if request.auth != null
          && docId == 'secrets'
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['webhookTokenHash', 'createdAt'])
          && request.resource.data.webhookTokenHash is string
          && request.resource.data.webhookTokenHash.matches('^[0-9a-f]{64}$')
          && request.resource.data.createdAt is number;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid == request.auth.uid;
      }
    }

    // Tout le reste est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
